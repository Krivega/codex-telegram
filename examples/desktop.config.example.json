{
  "version": 1,
  "hostId": "replace-with-a-unique-host-id",
  "telegram": {
    "userId": 123456789,
    "chatId": 123456789,
    "botId": 1234567890,
    "initialOffset": 0
  },
  "codex": {
    "socketPath": "/absolute/path/to/app-server-control.sock",
    "threadIds": [
      "replace-with-first-thread-id",
      "replace-with-second-thread-id"
    ],
    "pollIntervalMs": 5000,
    "transport": "desktop",
    "sessionsPath": "/absolute/path/to/.codex/sessions"
  },
  "notifications": {
    "maxTextLength": 3200
  },
  "artifacts": {
    "maxFileBytes": 20971520,
    "maxFiles": 5
  }
}
