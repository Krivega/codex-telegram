{
  "name": "codex-telegram",
  "version": "0.2.0",
  "private": true,
  "description": "Один Telegram-бот для задач Codex на нескольких компьютерах",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "codex-telegram": "bin/codex-telegram.mjs"
  },
  "scripts": {
    "setup": "node bin/codex-telegram.mjs setup",
    "start": "node bin/codex-telegram.mjs start",
    "doctor": "node bin/codex-telegram.mjs doctor",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "docs",
    "config.example.json",
    "examples"
  ],
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
